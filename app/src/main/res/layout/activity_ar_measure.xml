<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/arMeasureRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ar.ARMeasureActivity">

    <android.opengl.GLSurfaceView
        android:id="@+id/arSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.ARMeasure.ar.MeasurementOverlayView
        android:id="@+id/measurementOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/arStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_ar_top_panel"
        android:padding="12dp"
        android:gravity="center"
        android:text="@string/ar_status_scanning"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/surfaceInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_ar_top_panel"
        android:gravity="start"
        android:padding="10dp"
        android:text="@string/ar_surface_info_waiting"
        android:textColor="#D8F3EA"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rescanButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="156dp"
        android:layout_marginEnd="16dp"
        android:text="@string/ar_rescan"
        android:textAllCaps="false"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/reticleView"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_reticle"
        android:gravity="center"
        android:text="+"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/resultPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_ar_result_panel"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ar_result_title"
            android:textColor="#51625D"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/distanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ar_distance_empty"
            android:textColor="#10201C"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ar_result_hint"
            android:textColor="#5F706A"
            android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/arControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/undoButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/ar_undo"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/placePointButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.4"
            android:text="@string/ar_place_point"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/ar_reset"
            android:textAllCaps="false" />

    </LinearLayout>

    </LinearLayout>

</FrameLayout>
